# Optional approximate site location. Leave unset to use the Rajasthan bird list.
# SITE_LAT=your_approximate_latitude
# SITE_LON=your_approximate_longitude
DEVICE=auto
DEBUG_AUDIO=false
# Optional provisioned local sensor bridge. Store its secret only in .env.
# SENSOR_INGEST_TOKEN=
# SENSOR_ID=field-node-1
SENSOR_STALE_AFTER_SECONDS=120
# Local uploads have no byte-size ceiling by default. Optional deployment cap:
# UPLOAD_LIMIT_BYTES=10737418240
