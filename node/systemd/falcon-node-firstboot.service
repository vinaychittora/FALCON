# Runs install.sh once from the SD card's boot partition after the first boot with network.
# Installed by sdcard/firstboot-hook.sh; disabled again when the installation succeeds.
[Unit]
Description=FALCON sensor node first-boot installation
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/falcon-node/.installed

[Service]
Type=oneshot
ExecStart=/bin/bash @BUNDLE@/install.sh --from-boot
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
